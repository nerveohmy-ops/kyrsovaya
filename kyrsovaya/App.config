<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
  </startup>

  <connectionStrings>
    <!-- LocalDB ставится вместе с Visual Studio / SQL Server Express.
         Если у вас обычный SQL Server, замените Server, например на .\SQLEXPRESS -->
    <add name="ParkDb"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=NationalParkDB;Integrated Security=True;Connect Timeout=30"/>
  </connectionStrings>

  <appSettings>
    <!-- Настройки почты для функции «Забыли пароль».
         Если SmtpHost пустой, письмо сохраняется в папку Outbox рядом с exe. -->
    <add key="SmtpHost" value=""/>
    <add key="SmtpPort" value="587"/>
    <add key="SmtpUser" value=""/>
    <add key="SmtpPassword" value=""/>
  </appSettings>
</configuration>
